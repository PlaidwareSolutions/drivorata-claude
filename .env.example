# ---- Core ----
DATABASE_URL=postgresql://user:password@host:5432/drivorata
SESSION_SECRET=change-me            # signs sessions AND unsubscribe/reply tokens; keep identical across deploys
PORT=5000
APP_BASE_URL=https://drivorata.com  # absolute base URL used in emails and checkout redirects
TRUST_PROXY=1                       # hops to trust for X-Forwarded-*; 1 on Railway
# COOKIE_SECURE=true                # defaults to true when NODE_ENV=production

# ---- Build-time (client) ----
VITE_PLATFORM_DOMAIN=drivorata.com

# ---- Object storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=drivorata-uploads
# R2_PUBLIC_BASE_URL=https://cdn.drivorata.com   # optional custom domain bound to the bucket

# ---- Cloudflare for SaaS (tenant portal hostnames) ----
CLOUDFLARE_API_TOKEN=               # Zone -> SSL and Certificates -> Edit
CLOUDFLARE_ZONE_ID=
PORTAL_CNAME_TARGET=saas.drivorata.com
PORTAL_PROXY_SECRET=                # same value as the portal-proxy Worker secret

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_WEBHOOK_SECRET=
INBOUND_REPLY_DOMAIN=
SESSION_EMAIL_FROM=no-reply@drivorata.com
UNSUBSCRIBE_SECRET=

# ---- Background jobs & seeds ----
BACKGROUND_JOBS_ENABLED=1
STALE_CREDIT_REMINDER_INTERVAL_MINUTES=60
CART_REMINDER_INTERVAL_MINUTES=60
# BOOT_SEED_TENANT_IDS=1,28         # re-run idempotent promotion/online-course seeds for these tenants at boot
