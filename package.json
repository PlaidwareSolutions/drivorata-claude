    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "node dist/index.cjs",
    "check": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "db:push": "drizzle-kit push",
    "test": "TEST_AUTH_BYPASS=1 NODE_ENV=test BACKGROUND_JOBS_ENABLED=0 SESSION_SECRET=${SESSION_SECRET:-test-secret} PORT=0 node --import tsx --test --test-force-exit \"server/__tests__/*.test.ts\"",
    "test:unit": "TEST_AUTH_BYPASS=1 NODE_ENV=test BACKGROUND_JOBS_ENABLED=0 SESSION_SECRET=${SESSION_SECRET:-test-secret} PORT=0 node --import tsx --test --test-force-exit server/__tests__/service-fee.test.ts server/__tests__/resend-webhook.test.ts server/__tests__/inbound-email-webhook.test.ts"
  },
